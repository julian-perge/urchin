# Copy this file to .env for settings that differ per machine. The justfile
# loads .env, and a variable set in the shell wins over it. .env is git-ignored.

# The Godot binary. The default is the app bundle on macOS and `godot` on PATH
# elsewhere.
# GODOT_BIN=/path/to/godot

# The most Godot processes that run at once. The default, auto, is the number of
# CPU cores. Set a number when parallel agents run out of memory.
# GODOT_SLOTS=4
