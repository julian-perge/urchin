speeches = [{
"phase": 1.0,
"player": 1.0,
"say": "Do you know anything about the prison?",
"timeToSay": 2.5,
"turnTime": 6.0,
"turnTime2": 0.0,
"voiceOver": "v2_3"
}, {
"phase": 1.0,
"player": "Roald",
"say": "A prison? Here?",
"timeToSay": 2.0,
"turnTime": 6.0,
"turnTime2": 1.0,
"voiceOver": ""
}, {
"phase": 1.0,
"player": 1.0,
"say": "No, but not far. They were conducting experiments there, on the prisoners.",
"timeToSay": 4.0,
"turnTime": 6.0,
"turnTime2": 2.0,
"voiceOver": ""
}, {
"phase": 1.0,
"player": "Veradux",
"say": "Then the ZPCI showed up! Those guys just won't leave us alone.",
"timeToSay": 5.0,
"turnTime": 7.0,
"turnTime2": 0.0,
"voiceOver": "v2_4"
}, {
"phase": 1.0,
"player": "Roald",
"say": "The ZPCI? Are you sure? But they protect us - they're the good guys!",
"timeToSay": 5.5,
"turnTime": 7.0,
"turnTime2": 1.0,
"voiceOver": ""
}, {
"phase": 1.0,
"player": 1.0,
"say": "Somehow, I don't think so...",
"timeToSay": 2.0,
"turnTime": 7.0,
"turnTime2": 2.0,
"voiceOver": ""
}]
