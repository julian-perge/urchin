[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/battle/game_over_screen.gd" id="1_gameover"]
[ext_resource type="PackedScene" path="res://scenes/ui/menu/menu_background.tscn" id="2_background"]
[ext_resource type="PackedScene" path="res://scenes/ui/menu/menu_back.tscn" id="3_back"]

[node name="GameOverScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_gameover")

[node name="Background" parent="." instance=ExtResource("2_background")]
layout_mode = 0

[node name="DeadLabel" type="Label" parent="."]
layout_mode = 0
offset_left = 195.1
offset_top = 95.75
offset_right = 604.95
offset_bottom = 137.1
mouse_filter = 2
theme_type_variation = &"MenuCaption"
theme_override_constants/line_spacing = -12
theme_override_font_sizes/font_size = 30
horizontal_alignment = 1
autowrap_mode = 3
text = "You're dead, Sonny..."

[node name="ReloadLabel" type="Label" parent="."]
layout_mode = 0
offset_left = 252.9
offset_top = 174.4
offset_right = 547.1
offset_bottom = 203.45
mouse_filter = 2
theme_type_variation = &"MenuCaption"
theme_override_colors/font_color = Color(1, 0.8, 0, 1)
theme_override_font_sizes/font_size = 14
horizontal_alignment = 1
text = "< Click here to Re-Load >"

[node name="ReloadButton" type="Button" parent="."]
layout_mode = 0
offset_left = 255.5364
offset_top = 173
offset_right = 544.4636
offset_bottom = 203
focus_mode = 0
mouse_default_cursor_shape = 2
flat = true

[node name="TipLabel" type="Label" parent="."]
layout_mode = 0
offset_left = 116.15
offset_top = 233.65
offset_right = 682.95
offset_bottom = 345
mouse_filter = 2
theme_type_variation = &"MenuCaption"
theme_override_constants/line_spacing = -1
theme_override_font_sizes/font_size = 14
autowrap_mode = 3
text = "Having problems winning a fight? Observe your enemies carefully and try to find a weakness. Being victorious in Sonny is about having a successful strategy, so you may need to re-evaluate your ability configuration and execution. If you want guides on how to beat a specific stage, I recommend you to check out the ArmorGames or KrinLabs forums for some help."

[node name="Back" parent="." instance=ExtResource("3_back")]
layout_mode = 0

[connection signal="pressed" from="ReloadButton" to="." method="_on_reload_pressed"]
[connection signal="pressed" from="Back" to="." method="_on_back_pressed"]
