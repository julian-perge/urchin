; Every rect on the name screen is read from the original's root frame 64
; (nameMenu). A Label takes its edit text's rect and a flat Button its hit
; button's, and the black outline stands for the glow filter the original puts
; on each of these texts. NameInput fills the name box that shape 2713 draws, in
; the color, size and alignment of the name text 2712 inside it, and like 2712
; it sets no maximum length.
[node name="NamePanel" type="Control" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

